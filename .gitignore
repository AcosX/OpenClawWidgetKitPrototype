# macOS Finder metadata
.DS_Store

# Xcode build artifacts (regenerated by `xcodebuild`)
build-derived/
*.xcuserstate

# Xcode per-user IDE state (contains the local username)
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/

# A pre-edit copy of the project file kept locally for diffing
*.xcodeproj/project.pbxproj.before-appicon

# Local helper project (unrelated npm package)
.mimocode/
